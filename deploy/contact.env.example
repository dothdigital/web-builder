# Set only in Webtummy's private root .env. Never publish credentials.
# Contact messages are delivered to the configured Webtummy inbox.
CONTACT_TO_EMAIL="info@webtummy.com"
# Must be a verified AWS SES sender in CONTACT_SES_REGION.
CONTACT_FROM_EMAIL=""
CONTACT_SES_REGION="ca-central-1"
# Leave credentials blank when an appropriately scoped instance role is used.
CONTACT_SES_ACCESS_KEY=""
CONTACT_SES_SECRET_KEY=""
# Supports v2 checkbox (v2) or score-based v3 (v3). Configure BOTH keys.
# v3 validates hostname, contact action, and score >= 0.5.
# Register webtummy.com with Google reCAPTCHA.
CONTACT_RECAPTCHA_SITE_KEY=""
CONTACT_RECAPTCHA_SECRET_KEY=""
CONTACT_RECAPTCHA_TYPE="v3"
