# EXAMPLE ONLY: use deployment secrets / environment settings, not your local .env.
# AWS authentication comes from the application's EC2 instance profile or ECS task role.
HOSTING_S3_BUCKET=replace-with-private-published-sites-bucket
HOSTING_AWS_REGION=ca-central-1
HOSTING_CLOUDFRONT_OAC_ID=replace-with-terraform-output
HOSTING_PUBLIC_API_URL=https://app.webtummy.com
HOSTING_RESERVED_DOMAINS=webtummy.com
HOSTING_CRON_SECRET=replace-with-a-random-secret-at-least-32-characters-long
