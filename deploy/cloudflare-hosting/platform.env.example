# Webtummy application server. Secrets stay on the server.
CLOUDFLARE_ZONE_ID=replace-with-zone-id
CLOUDFLARE_API_TOKEN=replace-with-scoped-api-token
HOSTING_CNAME_TARGET=sites.webtummy.com
HOSTING_PREVIEW_DOMAIN=published.webtummy.com
HOSTING_PUBLIC_API_URL=https://app.webtummy.com
HOSTING_RESERVED_DOMAINS=webtummy.com
HOSTING_S3_BUCKET=replace-with-private-bucket
HOSTING_AWS_REGION=replace-with-bucket-region
HOSTING_CRON_SECRET=replace-with-random-secret-at-least-32-characters
# apiUrl = private agent administration endpoint; originUrl = private site traffic.
HOSTING_SERVERS_JSON='[{"id":"server-1","apiUrl":"http://10.0.1.10:9090","originUrl":"http://10.0.1.10:8081","token":"replace-with-random-server-token-at-least-32-characters","capacity":15,"enabled":true}]'
HOSTING_GATEWAY_IDS=server-1
