# Database
DATABASE_URL="postgresql://app:app@localhost:5432/awb?schema=public"

# Auth.js
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Background generation queue
REDIS_URL="redis://localhost:6379"
# Required for durable background generation; run the worker separately
USE_REDIS_QUEUE="true"

# AI provider: "stub" (deterministic, no key needed) or "openai"
AI_PROVIDER="stub"
OPENAI_API_KEY=""

# Assets: S3 when S3_BUCKET is set, otherwise the local folder below
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
S3_ENDPOINT=""
LOCAL_UPLOAD_DIR=".uploads"

# Multi-tenant renderer
PLATFORM_DOMAIN="localhost:3000"

# Cluster-wide AI job capacity (not individual API calls)
WEBSITE_JOB_CONCURRENCY=1
CONTENT_JOB_CONCURRENCY=2
CONTENT_JOBS_PER_MINUTE=12

# Completion emails; use an IAM role on AWS or dedicated SES credentials locally
SES_MAILER_AWS_REGION=ca-central-1
SES_MAILER_ACCESS_KEY=""
SES_MAILER_SECRET_KEY=""
SES_MAILER_FROM="info@webtummy.com"
# Set to the actual public builder URL when deployed
PUBLIC_APP_URL="http://localhost:3000"
