 assert.equal(await prisma.auditEvent.count({where:{workspaceId:owner.w.id,action:'admin.subscription.cancel-renewal'}}),1)
 console.log('PASS: real password login redirects; invoice pagination/download; anonymous, other-customer and support isolation; admin history and audited period-end cancellation. Stripe transport mocked; no live payment changes.')
