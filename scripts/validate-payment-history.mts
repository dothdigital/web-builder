 await manager.reload();await manager.locator('input[name=reason]').fill('Customer requested cancellation');await manager.locator('input[name=confirmed]').check();await manager.getByRole('button',{name:'Cancel subscription renewal',exact:true}).click();await manager.getByText('Renewal is cancelled. The subscription ends after the current paid period.',{exact:true}).waitFor();const updated=await prisma.workspace.findUniqueOrThrow({where:{id:owner.w.id}});assert.equal(updated.cancelAtPeriodEnd,true);assert.equal(updated.billingStatus,'active');assert.ok(updated.billingPaidThrough!>new Date());assert.equal(await prisma.auditEvent.count({where:{workspaceId:owner.w.id,actorId:admin.user.id,action:'admin.subscription.cancel-renewal'}}),1)
