 response=await customer.request.get(`${base}/api/billing/invoices/in_mockBillingA1?workspaceId=${owner.w.id}`,{maxRedirects:0});assert.equal(response.status(),302);assert.ok(response.headers()['location'].startsWith('https://pay.stripe.com/'));assert.equal(response.headers()['cache-control'],'private, no-store');
 response=await customer.request.get(`${base}/api/billing/invoices/in_mockBillingForeign?workspaceId=${owner.w.id}`,{maxRedirects:0});assert.equal(response.status(),403)
