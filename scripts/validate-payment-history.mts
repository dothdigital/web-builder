 const staff=await signIn(support.user.email);response=await staff.request.get(`${base}/admin/billing/${owner.w.id}`);assert.equal(response.status(),404);response=await staff.request.get(`${base}/api/billing/invoices/in_mockBillingA1?workspaceId=${owner.w.id}`,{maxRedirects:0});assert.equal(response.status(),403)
 const manager=await signIn(admin.user.email);await manager.goto(base+'/admin/users?q='+encodeURIComponent(owner.user.email));assert.equal(await manager.getByRole('link',{name:'View payments & subscription →'}).count(),1);await manager.getByRole('link',{name:'View payments & subscription →'}).click();await manager.waitForURL(base+'/admin/billing/'+owner.w.id);await manager.getByRole('heading',{name:'Payment history',exact:true}).waitFor();assert.equal(await manager.getByRole('link',{name:'Download invoice PDF ↓'}).count(),2);response=await manager.request.get(`${base}/api/billing/invoices/in_mockBillingA1?workspaceId=${owner.w.id}`,{maxRedirects:0});assert.equal(response.status(),302)
 await prisma.workspace.update({where:{id:owner.w.id},data:{stripeSubscriptionId:'sub_mockBillingA',billingStatus:'active',billingPaidThrough:new Date(Date.now()+25*86400000),billingLastReconciledAt:new Date()}})
 let submitted: { headers: Record<string, string>; body: string } | undefined
