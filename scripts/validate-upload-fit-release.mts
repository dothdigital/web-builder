import {config} from 'dotenv';config({path:'.env',quiet:true})
import {encode} from 'next-auth/jwt'
const {prisma}=await import('@awb/database')
const {chromium}=await import('/tmp/webtummy-ui-check/node_modules/playwright/index.mjs')
let browser:any,page:any
try{
 const project=await prisma.project.findUniqueOrThrow({where:{id:'cmveaqdzq003awhpa0cwv4dxt'},select:{workspaceId:true}})
 const member=await prisma.workspaceMember.findFirstOrThrow({where:{workspaceId:project.workspaceId},include:{user:true}})
 const user=member.user,salt='__Secure-authjs.session-token'
 const token=await encode({secret:process.env.AUTH_SECRET!,salt,token:{sub:user.id,sessionVersion:user.sessionVersion},maxAge:300})
 browser=await chromium.launch({headless:true,args:['--no-sandbox'],env:{...process.env,LD_LIBRARY_PATH:'/tmp/webtummy-browser-libs/root/usr/lib/x86_64-linux-gnu'}})
 const context=await browser.newContext({viewport:{width:1440,height:1000}})
 await context.addCookies([{name:salt,value:token,domain:'webtummy.com',path:'/',secure:true,httpOnly:true,sameSite:'Lax'}])
 page=await context.newPage();const errors:string[]=[];page.on('pageerror',(e:any)=>errors.push(e.message))
 // Exercise only transient editor state; block all server mutations.
 await page.route('**/*',async(r:any)=>{try{if(r.request().url().includes('thumbnail=1')){await r.fulfill({contentType:'image/gif',body:Buffer.from('R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7','base64')});return}if(r.request().method()==='POST'||r.request().headers()['next-router-prefetch'])await r.abort();else if(process.env.WEBTUMMY_REVIEW_ORIGIN && r.request().url().startsWith('https://webtummy.com/')){const response=await r.fetch({url:r.request().url().replace('https://webtummy.com',process.env.WEBTUMMY_REVIEW_ORIGIN),headers:{...await r.request().allHeaders(),host:'webtummy.com','x-forwarded-proto':'https'}});await r.fulfill({response})}else await r.continue()}catch{await r.abort().catch(()=>{})}})
 await page.goto('https://webtummy.com/projects/cmveaqdzq003awhpa0cwv4dxt/editor',{waitUntil:'domcontentloaded'})
 await page.waitForFunction(()=>document.getElementById('editor-object-quick-controls')?.style.height==='128px')
 const img=page.locator('[data-awb-canvas-scroll] [data-awb-element="/freeElements/0/content/items/1/imageUrl"]').last()
 await img.scrollIntoViewIfNeeded();await img.click()
 const fit=page.getByRole('region',{name:'Toolbar image controls',exact:true}).getByRole('combobox',{name:'Upload image fit',exact:true})
 await fit.waitFor()
 await fit.selectOption('cover')
 await page.waitForTimeout(100)
 if(await img.evaluate(el=>getComputedStyle(el).objectFit)!=='cover')throw Error('Crop option failed')
 await fit.selectOption('contain')
 await page.waitForTimeout(100)
 if(await img.evaluate(el=>getComputedStyle(el).objectFit)!=='contain')throw Error('Whole-image option failed')
 await page.getByRole('button',{name:'+ Add section',exact:true}).click()
 await page.getByRole('button',{name:'+ Blank section — build without AI',exact:true}).click()
 await page.getByRole('button',{name:'+ Add object',exact:true}).click()
 await page.getByRole('dialog').getByRole('button',{name:'Image',exact:true}).click()
 await fit.waitFor();await fit.selectOption('contain')
 await page.getByRole('button',{name:/^Choose from image library/}).first().click()
 await page.getByRole('button',{name:'Use insurance-partners-logo-banner.png',exact:true}).first().click()
 const loaded=page.locator('[data-awb-selected-frame="true"] img[src*="insurance-partners-logo-banner"]').last()
 await loaded.waitFor()
 if(await loaded.evaluate(el=>getComputedStyle(el).objectFit)!=='contain')throw Error('Fit selected before loading image was not retained')
 await page.getByRole('button',{name:'Appearance',exact:true}).click()
 const radius=page.getByRole('region',{name:'image settings',exact:true}).getByRole('slider',{name:'Corner radius',exact:true})
 await radius.press('Home');for(let i=0;i<24;i++)await radius.press('ArrowRight');await page.waitForTimeout(120)
 if(await loaded.evaluate(el=>getComputedStyle(el).objectFit)!=='contain')throw Error('Rounding reset the fit')
 if(await loaded.evaluate(el=>getComputedStyle(el).borderRadius)!=='24px')throw Error('Rounding did not apply')
 if(errors.length)throw Error(errors.join('; '))
 console.log('PASS: fit selector appears beside upload; both crop and whole-image choices update the canvas; saved banner loads as whole image; fit selected before loading a library image is retained. No test edits saved.')
}catch(error:any){console.error('FAIL:',String(error.message).split('Call log:')[0]);await page?.screenshot({path:'/tmp/upload-fit-test-failure.png'});process.exitCode=1}finally{await page?.unrouteAll({behavior:'ignoreErrors'});await browser?.close();await prisma.$disconnect()}
